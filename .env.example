# -----------------------------------------------------------------------------
# FPL Decision Engine -- Environment Variables Template
# Copy this file to `.env` and fill in your real values.
# The `.env` file is gitignored and must NEVER be committed.
# -----------------------------------------------------------------------------

# Neon PostgreSQL connection string (with sslmode=require)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Your FPL Team ID (numeric, found in your FPL profile URL)
FPL_TEAM_ID=

# Backend internal URL (used by Next.js server-side proxy)
# In Docker Compose this is http://backend:8000
# For local dev without Docker: http://localhost:8000
BACKEND_URL=http://backend:8000
